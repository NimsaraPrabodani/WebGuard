{
  "manifest_version": 3,
  "name": "WebGuard - Phishing Detection System",
  "version": "1.0",

    "icons": {
    
    "128": "icon/icon128.png"
  },

  "description": "Checks the current website for phishing indicators.",

  "permissions": [
    "tabs",
    "storage",
    "windows"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://web-guard-qtkt-psi.vercel.app/"
  
  ],

  "action": {
    "default_popup": "popup.html"
  }
}